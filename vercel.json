{
 "crons": [
  {
   "path": "/api/newsletter",
   "schedule": "30 16 * * 4"
  },
  {
   "path": "/api/push-we",
   "schedule": "0 15 * * 5"
  },
  {
   "path": "/api/push-snow",
   "schedule": "0 16 * * *"
  }
 ],
 "git": {
  "deploymentEnabled": {
   "propositions": false
  }
 },
 "buildCommand": "node tools/build.mjs",
 "outputDirectory": "dist",
 "functions": {
  "api/reel.js": {
   "maxDuration": 60
  }
 }
}
