{
 "crons": [
  {
   "path": "/api/newsletter",
   "schedule": "30 16 * * 4"
  },
  {
   "path": "/api/push?job=we",
   "schedule": "0 15 * * 5"
  },
  {
   "path": "/api/push?job=snow",
   "schedule": "0 16 * * *"
  }
 ],
 "git": {
  "deploymentEnabled": {
   "propositions": false
  }
 },
 "buildCommand": "node tools/build.mjs",
 "outputDirectory": "dist",
 "functions": {
  "api/main.js": {
   "maxDuration": 60
  }
 },
 "rewrites": [
  {
   "source": "/api/:fn(chat|compteur|ig|ig-auth|neige|newsletter|propose|push|reel|stats|subscribe|webcam)",
   "destination": "/api/main?fn=:fn"
  }
 ]
}
